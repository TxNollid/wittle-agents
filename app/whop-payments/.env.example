# Copy these names into the repository-root .env.local. Use sandbox values only.
WHOP_SANDBOX=true
WHOP_COMPANY_API_KEY=
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=
WHOP_PRICE=10.00
WHOP_WEBHOOK_SECRET=
PAYMENTS_SERVICE_TOKEN=
APP_URL=http://localhost:3210
PAYMENTS_PORT=3210

# Owner execution allowance, in USD minor units. Not a stored cash balance.
EXECUTION_BUDGET_MINOR=2000

# Evidence label for trusted backend source projections. Defaults to local_execution.
# fixture is for synthetic providers only. A label cannot establish provider proof.
PAYMENT_EVIDENCE_LEVEL=local_execution
