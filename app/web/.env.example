# fixture | sandbox | live. Default: fixture. Never a NEXT_PUBLIC_ credential.
WITTLE_WEB_MODE=fixture
# sandbox | empty | stale | unavailable | failed | pending (fixture mode only)
WITTLE_FIXTURE_SCENARIO=sandbox
# Explicitly enable only after coordinator/provider/QA handoff. No charge is made by web.
WITTLE_ENTRY_ENABLED=false
# Fixed HTTPS server-to-server endpoint; adapter contract in research/v2-web-handoff.md.
WITTLE_ENTRY_URL=
WITTLE_ENTRY_TOKEN=
# At least 32 random bytes, supplied via Vercel server settings; never a browser variable.
WITTLE_ENTRY_COOKIE_SECRET=
# Private payment-owner GET /api/payment-snapshot; never a browser-facing URL.
# Blank URL keeps built-in fixtures. A configured fixture source remains labelled fixture.
WITTLE_STATS_URL=
# Existing payment operator credential, provisioned server-side only. Never publish its value.
WITTLE_STATS_TOKEN=
# Returned opaque invitation URLs must use this exact approved Rooms origin.
WITTLE_ROOMS_ORIGIN=https://rooms.wittlelabs.ai
# Enable only in isolated local adapter smoke runs. Never in Vercel/production.
WITTLE_ALLOW_LOOPBACK_TEST_ADAPTERS=false
